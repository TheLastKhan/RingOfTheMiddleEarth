{
  "type": "record",
  "name": "WorldStateSnapshot",
  "namespace": "rotr.avro",
  "fields": [
    {"name": "type", "type": "string", "default": "WORLD_STATE"},
    {"name": "turn", "type": "int"},
    {
      "name": "regions",
      "type": ["null", {
        "type": "array",
        "items": {
          "type": "record",
          "name": "RegionSnapshot",
          "fields": [
            {"name": "id",           "type": "string"},
            {"name": "controller",   "type": "string"},
            {"name": "threatLevel",  "type": "int"},
            {"name": "fortified",    "type": "boolean"},
            {"name": "fortifyTurns", "type": "int"}
          ]
        }
      }],
      "default": null
    },
    {
      "name": "units",
      "type": ["null", {
        "type": "array",
        "items": {
          "type": "record",
          "name": "UnitSnapshot",
          "fields": [
            {"name": "id",            "type": "string"},
            {"name": "currentRegion", "type": "string"},
            {"name": "strength",      "type": "int"},
            {"name": "status",        "type": "string"},
            {"name": "respawnTurns",  "type": "int"},
            {"name": "cooldown",      "type": "int"}
          ]
        }
      }],
      "default": null
    },
    {
      "name": "paths",
      "type": ["null", {
        "type": "array",
        "items": {
          "type": "record",
          "name": "PathSnapshot",
          "fields": [
            {"name": "id", "type": "string"},
            {"name": "from", "type": "string", "default": ""},
            {"name": "to", "type": "string", "default": ""},
            {"name": "status", "type": "string"},
            {"name": "surveillanceLevel", "type": "int"},
            {"name": "tempOpenTurns", "type": "int"},
            {"name": "blockedBy", "type": "string", "default": ""},
            {"name": "corrupted", "type": "boolean", "default": false}
          ]
        }
      }],
      "default": null
    },
    {"name": "winner", "type": ["null", "string"], "default": null},
    {"name": "cause", "type": ["null", "string"], "default": null},
    {"name": "timestamp", "type": "long"}
  ]
}
